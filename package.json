{
  "name": "store-management-app",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant, mobile-first and offline-first store management platform.",
  "workspaces": [
    "apps/api",
    "apps/admin-web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run start:dev --workspace=@store-management-app/api",
    "dev:web": "npm run dev --workspace=@store-management-app/admin-web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "validate:foundation": "node scripts/validate_foundation.mjs",
    "db:lint": "supabase db lint --level error",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "prettier": "^3.6.2"
  }
}
