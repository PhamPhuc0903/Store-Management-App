{
  "name": "@store-management-app/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\" \"*.json\"",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
